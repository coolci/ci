# ===== 必填项 =====
# 暴露给浏览器访问的端口（Nginx 监听）
PUBLIC_PORT=8000

# PostgreSQL
POSTGRES_DB=ovhbuy
POSTGRES_USER=ovhbuy
POSTGRES_PASSWORD=请改为强密码

# Redis
REDIS_PASSWORD=请改为强密码

# JWT 签名密钥（至少 32 位随机字符串）
# 生成：openssl rand -base64 48
JWT_SECRET=请替换_至少32位的随机字符串_xxxxxxxxxxxxxxxxxx

# AES-256 加密密钥（必须正好 32 字节）
# 用于加密用户保存的 OVH AppKey/Secret/Consumer
# 生成：openssl rand -hex 16   （hex 32 字符 = 32 字节）
APP_ENCRYPTION_KEY=请替换_必须正好32个字符_xxxxxxxxxxx

# 允许的前端来源（多个用逗号分隔）。生产环境请填写真实域名。
CORS_ALLOWED_ORIGINS=http://localhost:8000
